{
  "name": "agent-ops-check",
  "version": "0.1.0",
  "description": "Local agent-ops analyzer: personal-to-work data crossover, irreversible actions, governance + cost, plus the Arup Banerjee Labs Agent Health Checker, Cloud Bill Smell and Observability Gap checks. The static scan makes no network calls. The optional eval command contacts only the agent you configure. Heuristic, not a security audit.",
  "bin": {
    "agent-ops-check": "bin/agent-ops-check.js"
  },
  "main": "src/index.js",
  "files": [
    "bin",
    "src",
    "rules",
    "data",
    "docs",
    "examples",
    "README.md",
    "LICENSE",
    "scripts",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node bin/agent-ops-check.js",
    "test": "node --test test/*.test.js",
    "example": "node bin/agent-ops-check.js examples/bad-agent --out report",
    "docs": "node scripts/gen-docs.js",
    "docs:check": "node scripts/gen-docs.js --check",
    "golden": "node scripts/golden.js",
    "golden:update": "node scripts/golden.js --update",
    "build:web": "node scripts/build-web.js",
    "build:labs": "node scripts/build-web.js --labs ../arup-banerjee-labs",
    "bench:llmail": "node scripts/bench-llmail.js",
    "bench:llmail:check": "node scripts/bench-llmail.js --check",
    "import:llmail": "node --max-old-space-size=8000 scripts/import-llmail.mjs"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "license": "MIT",
  "author": "Arup Kumar Banerjee",
  "repository": {
    "type": "git",
    "url": "https://github.com/ultimatixarup/agent-ops-check.git"
  },
  "keywords": [
    "ai-agents",
    "agent-ops",
    "mcp",
    "static-analysis",
    "governance",
    "local-first"
  ],
  "devDependencies": {
    "buffer": "^6.0.3",
    "esbuild": "^0.24.2",
    "jszip": "^3.10.1",
    "path-browserify": "^1.0.1"
  }
}
