          "ruleId": "crossover.shared_credential",
          "level": "error",
          "message": {
            "text": "Credential ANTHROPIC_API_KEY is used by 7 agents: agents, autonomous-coding, browser-use-demo, computer-use-best-practices, customer-support-agent, financial-data-analyst, managed-agents. They are not really separate agents if they share connections. Give each its own scoped token."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "."
                }
              }
            }
          ]
        },
        {
          "ruleId": "crossover.source_to_sink",
          "level": "error",
          "message": {
            "text": "Agent 'managed-agents' can read personal sources (personal_calendar_contacts, finance, tax_paths) and write to work sinks (slack, discord, generic_webhook). Split the connections, scope tokens read-only, and allowlist output channels."
          },
